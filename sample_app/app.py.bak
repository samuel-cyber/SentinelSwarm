"""
Sentinel Swarm — sample "victim" Flask app.
Deliberately simple; contains exactly 3 planted bugs for the demo.

Run locally:
    pip install -r requirements.txt
    flask --app app run
"""

from flask import Flask, request, jsonify

app = Flask(__name__)

# ---------------------------------------------------------------------------
# Fake in-memory "database"
# ---------------------------------------------------------------------------

USERS = {
    1: {"id": 1, "name": "Alice", "email": "alice@example.com", "age": 30},
    2: {"id": 2, "name": "Bob",   "email": "bob@example.com",   "age": 25},
    3: {"id": 3, "name": "Carol", "email": "carol@example.com", "age": 22},
    4: {"id": 4, "name": "Dave",  "email": "dave@example.com",  "age": 17},
    5: {"id": 5, "name": "Eve",   "email": "eve@example.com",   "age": 34},
}


# ---------------------------------------------------------------------------
# Route 1 — get a single user by id
# ---------------------------------------------------------------------------

def get_user_by_id(user_id):
    """Return the user dict for the given id, or None if not found."""
    # BUG 1 is here — see PLANTED_BUGS.md
    return USERS.get(user_id)


@app.route("/users/<user_id>")
def user_detail(user_id):
    user = get_user_by_id(user_id)
    if user is None:
        return jsonify({"error": "User not found"}), 404
    return jsonify(user)


# ---------------------------------------------------------------------------
# Route 2 — paginate a list of results
# ---------------------------------------------------------------------------

def paginate_results(items, page, page_size=2):
    """
    Return the slice of *items* that belongs to *page* (1-indexed).
    Example: page=1, page_size=2 → items[0:2]
             page=2, page_size=2 → items[2:4]
    """
    # BUG 2 is here — see PLANTED_BUGS.md
    start = (page - 1) * page_size
    end   = start + page_size + 1        # off-by-one: should be start + page_size
    return items[start:end]


@app.route("/users")
def user_list():
    page = int(request.args.get("page", 1))
    all_users = list(USERS.values())
    page_data = paginate_results(all_users, page)
    return jsonify(page_data)


# ---------------------------------------------------------------------------
# Route 3 — simple form / JSON input handler: register a new user
# ---------------------------------------------------------------------------

def register_user(data):
    """
    Validate and insert a new user from a dict with keys:
      name  (str, required)
      email (str, required)
      age   (int, required, must be >= 18)

    Returns (user_dict, None) on success or (None, error_message) on failure.
    """
    name  = data.get("name", "").strip()
    email = data.get("email", "").strip()
    age   = data.get("age")

    if not name:
        return None, "name is required"
    if not email:
        return None, "email is required"
    # BUG 3 is here — see PLANTED_BUGS.md
    if age < 18:                          # crashes when age is None or a string
        return None, "must be 18 or older"

    new_id = max(USERS.keys()) + 1
    user   = {"id": new_id, "name": name, "email": email, "age": age}
    USERS[new_id] = user
    return user, None


@app.route("/users", methods=["POST"])
def create_user():
    data = request.get_json(force=True, silent=True) or {}
    user, err = register_user(data)
    if err:
        return jsonify({"error": err}), 400
    return jsonify(user), 201


# ---------------------------------------------------------------------------

if __name__ == "__main__":
    app.run(debug=True)
