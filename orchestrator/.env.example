# Copy this file to .env and fill in your key
# Get an Inference-scoped API key from https://bob.ibm.com
BOBSHELL_API_KEY=your_inference_key_here

# Dev smoke-test routes (/test-scout, /test-saboteur, /test-medic).
# They are unauthenticated and each one spends real Bob API calls, so they
# are OFF by default — leave this unset on any public deployment.
# Set to 1 locally when you want to exercise a single step in isolation.
# SENTINEL_DEV_ROUTES=1
